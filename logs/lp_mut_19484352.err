Shell command: 
        set -euo pipefail

        # --- Define temporary file paths as shell variables ---
        OUTDIR=$(dirname /data/scratch/DMP/UCEC/GENEVOD/qguo/Projects/lp_mut/results/sample1/Variants_Octopus_v0.5.2/sample1.octopus.filtered.vcf)
        
        AVINPUT=$OUTDIR/sample1.octopus.vcf.avinput
        F1=$OUTDIR/sample1.1.hg19_ALL.sites.2015_08_filtered
        F2=$OUTDIR/sample1.2.hg19_esp6500siv2_all_filtered
        F3=$OUTDIR/sample1.3.hg19_exac03nontcga_filtered
        F4=$OUTDIR/sample1.4.hg19_gnomad211_genome_filtered
        F5=$OUTDIR/sample1.5.hg19_kaviar_20150923_filtered

        merge_chunks() {
            local final="$1"
            if compgen -G "${final}."* > /dev/null; then
                printf '%s\n' "${final}."* | sort -V | xargs cat -- > "${final}"
                rm -f "${final}."*
            fi
        }

        # --- Step 0: Convert VCF to AVINPUT ---
        /data/scratch/DMP/UCEC/GENEVOD/qguo/Projects/lp_mut/scripts/convert2annovar.pl -format vcf4 /data/scratch/DMP/UCEC/GENEVOD/qguo/Projects/lp_mut/results/sample1/Variants_Octopus_v0.5.2/sample1.octopus.vcf -includeinfo > $AVINPUT 2> logs/sample1_filter_mutation.log

        # --- Step 1: 1000g ---
        /data/scratch/DMP/UCEC/GENEVOD/qguo/Projects/lp_mut/scripts/annotate_variation.pl -filter -dbtype 1000g2015aug_all -buildver hg19 \
            -out $OUTDIR/sample1.1 $AVINPUT /data/rds/DMP/UCEC/GENEVOD/qguo/Reference/genome/annovar/humandb/ \
            -maf 0.001 -thread 4 >> logs/sample1_filter_mutation.log 2>&1
        merge_chunks $F1

        # --- Step 2: esp6500 ---
        /data/scratch/DMP/UCEC/GENEVOD/qguo/Projects/lp_mut/scripts/annotate_variation.pl -filter -dbtype esp6500siv2_all -buildver hg19 \
            -out $OUTDIR/sample1.2 $F1 /data/rds/DMP/UCEC/GENEVOD/qguo/Reference/genome/annovar/humandb/ \
            -score_threshold 0.001 -thread 4 >> logs/sample1_filter_mutation.log 2>&1
        merge_chunks $F2

        # --- Step 3: exac03 ---
        /data/scratch/DMP/UCEC/GENEVOD/qguo/Projects/lp_mut/scripts/annotate_variation.pl -filter -dbtype exac03nontcga -buildver hg19 \
            -out $OUTDIR/sample1.3 $F2 /data/rds/DMP/UCEC/GENEVOD/qguo/Reference/genome/annovar/humandb/ \
            -score_threshold 0.001 -thread 4 >> logs/sample1_filter_mutation.log 2>&1
        merge_chunks $F3

        # --- Step 4: gnomad ---
        /data/scratch/DMP/UCEC/GENEVOD/qguo/Projects/lp_mut/scripts/annotate_variation.pl -filter -dbtype gnomad211_genome -buildver hg19 \
            -out $OUTDIR/sample1.4 $F3 /data/rds/DMP/UCEC/GENEVOD/qguo/Reference/genome/annovar/humandb/ \
            -score_threshold 0.005 -thread 4 >> logs/sample1_filter_mutation.log 2>&1
        merge_chunks $F4

        # --- Step 5: kaviar ---
        /data/scratch/DMP/UCEC/GENEVOD/qguo/Projects/lp_mut/scripts/annotate_variation.pl -filter -dbtype kaviar_20150923 -buildver hg19 \
            -out $OUTDIR/sample1.5 $F4 /data/rds/DMP/UCEC/GENEVOD/qguo/Reference/genome/annovar/humandb/ \
            -score_threshold 0.001 -thread 4 >> logs/sample1_filter_mutation.log 2>&1
        merge_chunks $F5
        
        # --- Final Step: Create VCF ---
        cut -f 6-16 $F5 > /data/scratch/DMP/UCEC/GENEVOD/qguo/Projects/lp_mut/results/sample1/Variants_Octopus_v0.5.2/sample1.octopus.filtered.vcf

        # --- Clean up ---
        rm -f $OUTDIR/sample1.*_dropped $OUTDIR/sample1.*.log $OUTDIR/sample1.*.invalid_input $OUTDIR/sample1.*_filtered $OUTDIR/sample1*avinput
        
